@@ -0,0 +1,114 @@
+//! Bounded static inline images; never fetch a tool-supplied URL or file.
+
+use base64::{Engine as _, engine::general_purpose::STANDARD};
+use image::{ImageFormat, ImageReader, Limits};
+use std::io::Cursor;
+use tinytools::{ImageData, ToolContent};
+
+pub(super) const MAX_IMAGES: usize = 2;
+pub(super) const MAX_IMAGE_BYTES: usize = 2 * 1024 * 1024;
+pub(super) const MAX_TOTAL_BYTES: usize = 4 * 1024 * 1024;
+const MAX_PIXELS: u64 = 4_194_304;
+const MAX_AXIS: u32 = 4096;
+const MAX_ENCODED: usize = 4 * MAX_IMAGE_BYTES.div_ceil(3);
+
+/// Validate before allocating pixels or forwarding an attachment. Error strings
+/// contain only fixed labels, never a decoder diagnostic or tool payload.
+pub(super) fn inline_image(
+    data: String,
+    mime: String,
+) -> Result<(ToolContent, usize), &'static str> {
+    let format = match mime.as_str() {
+        "image/png" => ImageFormat::Png,
+        "image/jpeg" => ImageFormat::Jpeg,
+        "image/webp" => ImageFormat::WebP,
+        _ => return Err("unsupported format"),
+    };
+    if data.is_empty() || data.len() > MAX_ENCODED {
+        return Err("attachment exceeds limit");
+    }
+    let bytes = STANDARD.decode(&data).map_err(|_| "invalid base64")?;
+    if bytes.len() > MAX_IMAGE_BYTES || STANDARD.encode(&bytes) != data {
+        return Err("invalid base64 or size");
+    }
+    if image::guess_format(&bytes).ok() != Some(format) {
+        return Err("format mismatch");
+    }
+    if animated(&bytes, format) {
+        return Err("animated images are unsupported");
+    }
+    let reader = ImageReader::with_format(Cursor::new(&bytes), format);
+    let (width, height) = reader.into_dimensions().map_err(|_| "invalid image")?;
+    if width == 0
+        || height == 0
+        || width > MAX_AXIS
+        || height > MAX_AXIS
+        || u64::from(width) * u64::from(height) > MAX_PIXELS
+    {
+        return Err("image dimensions exceed limit");
+    }
+    let mut limits = Limits::default();
+    limits.max_image_width = Some(MAX_AXIS);
+    limits.max_image_height = Some(MAX_AXIS);
+    limits.max_alloc = Some(64 * 1024 * 1024);
+    let mut reader = ImageReader::with_format(Cursor::new(&bytes), format);
+    reader.limits(limits);
+    reader.decode().map_err(|_| "invalid image")?;
+    Ok((
+        ToolContent::Image {
+            media_type: mime,
+            data: ImageData::Base64(data),
+        },
+        bytes.len(),
+    ))
+}
+
+fn animated(bytes: &[u8], format: ImageFormat) -> bool {
+    match format {
+        ImageFormat::Png => {
+            let mut offset = 8usize;
+            while offset.checked_add(12).is_some_and(|end| end <= bytes.len()) {
+                let count =
+                    u32::from_be_bytes(bytes[offset..offset + 4].try_into().unwrap()) as usize;
+                if &bytes[offset + 4..offset + 8] == b"acTL" {
+                    return true;
+                }
+                let Some(next) = offset.checked_add(12).and_then(|n| n.checked_add(count)) else {
+                    return true;
+                };
+                if next > bytes.len() {
+                    return true;
+                }
+                offset = next;
+            }
+            false
+        }
+        ImageFormat::WebP => {
+            let mut offset = 12usize;
+            while offset.checked_add(8).is_some_and(|end| end <= bytes.len()) {
+                let kind = &bytes[offset..offset + 4];
+                let count =
+                    u32::from_le_bytes(bytes[offset + 4..offset + 8].try_into().unwrap()) as usize;
+                if kind == b"ANIM"
+                    || kind == b"ANMF"
+                    || (kind == b"VP8X" && bytes.get(offset + 8).is_some_and(|flag| flag & 2 != 0))
+                {
+                    return true;
+                }
+                let Some(next) = offset
+                    .checked_add(8)
+                    .and_then(|n| n.checked_add(count))
+                    .and_then(|n| n.checked_add(count & 1))
+                else {
+                    return true;
+                };
+                if next > bytes.len() {
+                    return true;
+                }
+                offset = next;
+            }
+            false
+        }
+        _ => false,
+    }
+}
