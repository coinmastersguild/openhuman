+++ b/crates/tinymcp/src/tools/image_tests.rs
@@ -0,0 +1,92 @@
+//! Regression coverage for native image feedback, not encoded text placeholders.
+
+use base64::{Engine as _, engine::general_purpose::STANDARD};
+use image::{DynamicImage, ImageFormat, RgbaImage};
+use serde_json::{Value, json};
+use std::io::Cursor;
+use tinytools::{ImageData, ToolContent};
+
+fn png(width: u32, height: u32) -> String {
+    let mut pixels = RgbaImage::new(width, height);
+    let mut seed = 19u32;
+    for pixel in pixels.pixels_mut() {
+        for channel in pixel.0.iter_mut().take(3) {
+            seed = seed.wrapping_mul(1_664_525).wrapping_add(1_013_904_223);
+            *channel = (seed >> 24) as u8;
+        }
+        pixel.0[3] = 255;
+    }
+    let mut encoded = Cursor::new(Vec::new());
+    DynamicImage::ImageRgba8(pixels).write_to(&mut encoded, ImageFormat::Png).unwrap();
+    STANDARD.encode(encoded.into_inner())
+}
+
+fn result(blocks: Vec<Value>) -> tinytools::ToolResult {
+    super::tool_result(crate::render_tool_result(&json!({ "content": blocks })))
+}
+
+fn image(data: &str) -> Value {
+    json!({"type":"image", "mimeType":"image/png", "data":data})
+}
+
+#[test]
+fn pioneer_runtime_large_image_feedback_is_native_and_not_duplicate_encoded_text() {
+    let encoded = png(192, 128);
+    assert!(encoded.len() > super::MAX_LLM_BLOCK_BYTES);
+    let reply = result(vec![image(&encoded)]);
+    assert!(!reply.is_error);
+    assert_eq!(reply.follow_up.len(), 1);
+    assert!(matches!(&reply.follow_up[0], ToolContent::Image { media_type, data: ImageData::Base64(value) }
+        if media_type == "image/png" && value == &encoded));
+    assert!(!reply.output().contains(&encoded));
+    assert!(reply.output().len() < 256);
+}
+
+#[test]
+fn pioneer_runtime_multiple_images_keep_order_and_all_text_blocks() {
+    let first = png(1, 1); let second = png(2, 1);
+    let reply = result(vec![json!({"type":"text","text":"before"}), image(&first),
+        json!({"type":"text","text":"after"}), image(&second)]);
+    assert!(!reply.is_error);
+    assert!(reply.text().contains("before") && reply.text().contains("after"));
+    assert_eq!(reply.follow_up.len(), 2);
+    for (block, expected) in reply.follow_up.iter().zip([first, second]) {
+        assert!(matches!(block, ToolContent::Image { data: ImageData::Base64(value), .. } if value == &expected));
+    }
+}
+
+#[test]
+fn pioneer_runtime_invalid_inline_images_fail_explicitly_without_payload_echo() {
+    let valid = png(1, 1);
+    let cases = [
+        json!({"type":"image","mimeType":"image/png","data":"not canonical!"}),
+        json!({"type":"image","mimeType":"image/png","data":STANDARD.encode(b"not a PNG")}),
+        json!({"type":"image","mimeType":"image/jpeg","data":valid}),
+        json!({"type":"image","mimeType":"image/svg+xml","data":valid}),
+        json!({"type":"image","mimeType":"image/png","url":"https://example.invalid/image.png"}),
+        json!({"type":"image","mimeType":"image/png","data":"x".repeat(3 * 1024 * 1024)}),
+        image(&png(4097, 1)),
+        image(&png(2049, 2049)),
+    ];
+    for block in cases {
+        let encoded = block.get("data").and_then(Value::as_str).unwrap_or_default().to_owned();
+        let reply = result(vec![block]);
+        assert!(reply.is_error);
+        assert!(reply.follow_up.is_empty());
+        assert!(reply.output().len() < 256);
+        if !encoded.is_empty() { assert!(!reply.output().contains(&encoded)); }
+    }
+}
+
+#[test]
+fn pioneer_runtime_image_count_and_tool_errors_never_forward_pixels() {
+    let encoded = png(1, 1);
+    let too_many = result(vec![image(&encoded), image(&encoded), image(&encoded)]);
+    assert!(too_many.is_error && too_many.follow_up.is_empty());
+    let failed = super::tool_result(crate::render_tool_result(&json!({
+        "isError":true,"content":[{"type":"text","text":"render failed"},image(&encoded)]
+    })));
+    assert!(failed.is_error && failed.follow_up.is_empty());
+    assert!(failed.text().contains("render failed"));
+    assert!(!failed.output().contains(&encoded));
+}
